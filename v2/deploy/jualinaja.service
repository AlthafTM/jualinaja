[Unit]
Description=JualinAja — pasar barang bekas antar warga
After=network.target

[Service]
Type=simple
User=%i
WorkingDirectory=%h/Projects/jualinaja
ExecStart=/usr/bin/python3 app/server.py 8123
Restart=on-failure
RestartSec=3
StandardOutput=append:%h/Projects/jualinaja/data/server.log
StandardError=append:%h/Projects/jualinaja/data/server.log
# Pengamanan dasar
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/Projects/jualinaja/data

[Install]
WantedBy=default.target
